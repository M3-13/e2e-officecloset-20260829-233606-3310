{
  "runcontract": 1,
  "services": [
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "install"
        ]
      ],
      "start": [
        "node",
        "node_modules/vite/bin/vite.js",
        "--port",
        "${PORT}"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_URL": {
          "dev": "http://localhost:8000"
        }
      }
    },
    {
      "name": "backend",
      "dir": ".",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "backend.main:app",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [
          200
        ]
      },
      "env": {
        "DATABASE_URL": {
          "dev": "sqlite:///./wardrobe.db"
        },
        "UPLOAD_DIR": {
          "dev": "./uploads"
        },
        "SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "FRONTEND_ORIGIN": {
          "dev": "http://localhost:5173"
        },
        "VITE_API_URL": {
          "dev": "http://localhost:8000"
        }
      }
    }
  ]
}
